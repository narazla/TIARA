# TIARA - Environment Variables Template
# Salin file ini ke backend/.env dan isi nilainya.
# JANGAN commit file .env ke repositori.

# ── Database ──────────────────────────────────────────────────
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://tiara:tiara_password@localhost:5432/tiara_db

# Variabel untuk Docker Compose (digunakan di docker-compose.yml)
POSTGRES_USER=tiara
POSTGRES_PASSWORD=tiara_password
POSTGRES_DB=tiara_db

# ── JWT ───────────────────────────────────────────────────────
# Minimal 32 karakter acak. Buat dengan:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=<isi-kunci-jwt-anda-minimum-32-karakter>
JWT_ALGORITHM=HS256
# Masa berlaku access token dalam menit
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Masa berlaku dashboard token caregiver dalam menit
CAREGIVER_DASHBOARD_TOKEN_EXPIRE_MINUTES=30

# ── Media Storage ─────────────────────────────────────────────
# Path untuk menyimpan rekaman audio terenkripsi
MEDIA_STORAGE_PATH=./media_storage

# Kunci Fernet untuk mengenkripsi berkas rekaman (.webm.enc).
# WAJIB diisi. Buat dengan:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# PERINGATAN: jika kunci hilang, semua rekaman terenkripsi tidak bisa dibuka lagi.
MEDIA_ENCRYPTION_KEY=<isi-kunci-fernet-anda>

# ── Speech-to-Text ────────────────────────────────────────────
# Ukuran model faster-whisper. Pilihan: tiny, base, small, medium, large-v3
# Model diunduh otomatis saat pertama dipakai (~145 MB untuk base).
WHISPER_MODEL_SIZE=base

# ── LLM (untuk Dementia Guidance AI) ─────────────────────────
# Provider LLM. Pilihan: none | gemini | openai | anthropic
LLM_PROVIDER=gemini
# Kunci API untuk provider yang dipilih.
# Untuk Gemini: dapatkan dari https://aistudio.google.com/apikey
LLM_API_KEY=<isi-kunci-api-llm-anda>

# ── CORS ─────────────────────────────────────────────────────
# Origin frontend yang diizinkan. Bisa beberapa, dipisah koma:
# FRONTEND_URL=https://tiaracare.my.id,https://www.tiaracare.my.id
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# ── App ───────────────────────────────────────────────────────
APP_NAME=TIARA API
APP_VERSION=1.0.0
DEBUG=False

# ── Demo / Simulation Mode ────────────────────────────────────
# True  = seed script membuat data simulasi; dashboard menampilkan label "data simulasi"
# False = mode produksi, hanya data analisis nyata yang ditampilkan
DEMO_MODE=True
